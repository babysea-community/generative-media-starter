# ============================================================================
# Generative Media Starter
# Ship with auth, credits, storage, and generation
#
# First deploy tip:
# - Keep the default stack until your first image works.
# - Fill required values only.
# - Leave optional fields blank until you intentionally choose to use them.
# - Never commit real secret values to Git.
# ============================================================================

# ----------------------------------------------------------------------------
# CONFIG
# ----------------------------------------------------------------------------

# The exact URL where the app runs
# Local development: http://localhost:3011
# Production (your custom domain): https://your-starter.example.com
NEXT_PUBLIC_SITE_URL=

# ----------------------------------------------------------------------------
# DATABASE & AUTH
# ----------------------------------------------------------------------------

# Database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLIC_KEY=
SUPABASE_SECRET_KEY=

# Auth
# In your Google Cloud console:
# - Create OAuth 2.0 Client IDs for `Web application`
# - Add `https://your-starter-example.com` in `Authorized JavaScript origins`
# - Add `https://your-supabase-project-id.supabase.co/auth/v1/callback` in `Authorized redirect URIs`
# - Copy `Client ID` and `Client secrets`
# In your Supabase dashboard:
# - Enable Sign in with Google
# - Fill `Client IDs` and `Client Secret (for OAuth)` from your Google Cloud console above
# - Add `https://your-starter-example.com` in `Site URL`
# - Add `https://your-starter-example.com/auth/callback` in `Redirect URLs`

# ----------------------------------------------------------------------------
# INFERENCE
# ----------------------------------------------------------------------------

# Server-only BabySea API key used by the official BabySea SDK
# Learn: https://docs.babysea.ai
# You should change BABYSEA_API_BASE_URL depend on your account region
BABYSEA_API_KEY=
BABYSEA_API_BASE_URL=https://api.us.babysea.ai

# ----------------------------------------------------------------------------
# BILLING
# ----------------------------------------------------------------------------

# Stripe
# Learn: https://docs.stripe.com/keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional direct Price ID overrides
# If unset, the app resolves Prices by lookup key from `lib/app-config.ts`
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUILDER=
STRIPE_PRICE_PRODUCTION=

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------

# Upstash Redis REST values for generation rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----------------------------------------------------------------------------
# OBSERVABILITY (optional)
# ----------------------------------------------------------------------------

# Sentry
# Skip this for your first deploy unless you already use Sentry
# Learn: https://docs.sentry.io/platforms/javascript/guides/nextjs
# Sample rates (traces/replays) are hardcoded in (edit to tune):
# - `lib/monitoring/sentry-config.ts`
# - `instrumentation-client.ts`
# Leave blank to run without error tracking (the starter no-ops cleanly)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Required only to upload source maps at build time (never expose to client)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
