# ============================================================================
# Generative Media Starter
# Production-ready SaaS for AI image and video generation
# on top of the BabySea API and Stripe billing.
#
# First deploy tip:
# - Keep the default stack until your first generation works.
# - Fill required values only.
# - Leave optional Sentry values blank unless you already use Sentry.
# - Never commit real secret values to Git.
# ============================================================================

# ----------------------------------------------------------------------------
# CONFIG
# ----------------------------------------------------------------------------

# The exact URL where the app runs
# Local development: http://localhost:3011
# Production: https://<your_domain>
# One-click deploy, use the temporary `.vercel.app` or `.netlify.app` URL first
# Update this after you attach a custom domain
NEXT_PUBLIC_SITE_URL=

# ----------------------------------------------------------------------------
# DATABASE & AUTH
# ----------------------------------------------------------------------------

# Database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLIC_KEY=
SUPABASE_SECRET_KEY=

# ----------------------------------------------------------------------------
# INFERENCE
# ----------------------------------------------------------------------------

# Server-only BabySea API key used by the official BabySea SDK
# Learn: https://docs.babysea.ai
# You should change BABYSEA_API_BASE_URL depend on your account region
BABYSEA_API_KEY=
BABYSEA_API_BASE_URL=https://api.us.babysea.ai

# ----------------------------------------------------------------------------
# BILLING
# ----------------------------------------------------------------------------

# Stripe
# Learn: https://docs.stripe.com/keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional direct Price ID overrides
# If unset, the app resolves Prices by lookup key from `lib/app-config.ts`.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUILDER=
STRIPE_PRICE_PRODUCTION=

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------

# Upstash Redis REST values for generation rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----------------------------------------------------------------------------
# OBSERVABILITY (optional)
# ----------------------------------------------------------------------------

# Sentry
# Skip this for your first deploy unless you already use Sentry
# Learn: https://docs.sentry.io/platforms/javascript/guides/nextjs
# Sample rates (traces/replays) are hardcoded in (edit to tune):
# - `lib/monitoring/sentry-config.ts`
# - `instrumentation-client.ts`
# Leave blank to run without error tracking (the starter no-ops cleanly)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Required only to upload source maps at build time (never expose to client)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
